# Generated output.
_site/

# Added when running `jekyll new PATH` or serving in incremental mode.
.jekyll-metadata

.jekyll-cache/
.sass-cache/

# Bundle's config.
.bundle/
vendor/

# Other things
node_modules
Gemfile.lock
*.gem

# BMad v7 and its skills are installed, not committed. Restore a fresh clone with
#   npx skills add bmad-code-org/BMAD-METHOD --skill '*' -y
# then ask the bmad skill to run setup. _bmad/custom/ (hand-written overrides) stays tracked.
.agents/skills/
.claude/skills/
_bmad/*
!_bmad/custom/
skills-lock.json
